---
const links = [
	{ href: '/', label: 'Accueil' },
	{ href: '/#projets', label: 'Projets' },
	{ href: '/#contact', label: 'Contact' },
];
---

<header class="border-b-2 border-ink bg-paper">
	<div class="relative mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
		<a href="/" class="text-xl font-black tracking-tight uppercase">
			Florent Albert
		</a>

		<nav aria-label="Navigation principale" class="hidden md:block">
			<ul class="flex items-center gap-6">
				{links.map(({ href, label }) => (
					<li>
						<a href={href} class="font-semibold underline-offset-4 hover:underline">
							{label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<details class="group md:hidden">
			<summary class="cursor-pointer list-none border-2 border-ink px-3 py-2 font-bold shadow-brutal group-open:bg-ink group-open:text-paper group-open:shadow-none [&::-webkit-details-marker]:hidden">
				Menu
			</summary>
			<nav
				aria-label="Navigation mobile"
				class="absolute inset-x-0 top-full z-10 border-b-2 border-ink bg-paper"
			>
				<ul class="flex flex-col gap-2 px-4 py-4">
					{links.map(({ href, label }) => (
						<li>
							<a href={href} class="block py-2 font-semibold">
								{label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		</details>
	</div>
</header>
